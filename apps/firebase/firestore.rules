rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        ('roles' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         role in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles) ||
        ('role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role)
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isManager() {
      return hasRole('manager') || hasRole('admin');
    }

    function isSales() {
      return hasRole('sales') || hasRole('manager') || hasRole('admin');
    }

    function isSupport() {
      return hasRole('support') || hasRole('manager') || hasRole('admin');
    }

    function isPublisher() {
      return hasRole('publisher') || hasRole('manager') || hasRole('admin');
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isManager() || isSales() || isOwner(userId);
    }

    // Contacts collection
    match /contacts/{contactId} {
      allow read: if isAuthenticated();
      allow create: if isSales() || isAdmin();
      allow update: if isSales() || isAdmin() ||
        (resource.data.ownerId == request.auth.uid) ||
        (resource.data.email == request.auth.token.email);
      allow delete: if isAdmin() || isManager();
    }

    // Companies collection
    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow create: if isSales() || isAdmin();
      allow update: if isSales() || isAdmin() ||
        (resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin() || isManager();
    }

    // Deals collection
    match /deals/{dealId} {
      allow read: if isAuthenticated();
      allow create: if isSales() || isAdmin();
      allow update: if isSales() || isAdmin() ||
        (resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin() || isManager();
    }

    // Activities collection
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isSales() || isSupport() || isAdmin();
      allow update: if isSales() || isSupport() || isAdmin() ||
        (resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin() || isManager();
    }

    // Tickets collection
    match /tickets/{ticketId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isSupport() || isAdmin() ||
        (resource.data.assigneeId == request.auth.uid);
      allow delete: if isAdmin() || isManager();
    }

    // Knowledge Base collection
    match /knowledgeBase/{articleId} {
      allow read: if isAuthenticated();
      allow write: if isSupport() || isAdmin();
    }

    // Blog Posts collection
    match /blog_posts/{postId} {
      allow read: if true;
      allow write: if isPublisher();
    }

    // Workflows collection
    match /workflows/{workflowId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isManager();
    }

    // Audit Log collection
    match /auditLog/{logId} {
      allow read: if isAdmin() || isManager();
      allow create: if isAuthenticated();
    }
  }
}
