{
	"name": "@abtec/emulators",
	"version": "1.0.0",
	"private": true,
	"description": "Configuración centralizada y modular de emuladores de Firebase",
	"scripts": {
		"dev": "npx firebase emulators:start --project abtec-8f31e --import=./emulators-data --export-on-exit=./emulators-data",
		"export-data": "npx firebase emulators:export ./emulators-data --project abtec-8f31e",
		"auth-emulators": "cross-env GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json npx firebase emulators:start --project abtec-8f31e --import=./emulators-data --export-on-exit=./emulators-data",
		"test:firestore": "npx firebase emulators:exec --project abtec-8f31e \"node --test tests/firestore/\"",
		"test:rtdb-analytics": "npx firebase emulators:exec --project abtec-8f31e \"node --test tests/realtime/analytics/\""
	},
	"devDependencies": {
		"cross-env": "^7.0.3"
	}
}
